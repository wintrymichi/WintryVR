<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>WintryCheck.Android</AssemblyName>
    <RootNamespace>WintryCheck</RootNamespace>
    <DefineConstants>UNITY_ANDROID;UNITY_64;UNITY_2020_1_OR_NEWER;UNITY_2021_1_OR_NEWER;UNITY_2022_1_OR_NEWER;UNITY_6000_0_OR_NEWER;WINTRY_URP</DefineConstants>
    <NoWarn>1591;8981</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <BaseIntermediateOutputPath>obj\Android\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\Android\</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Stubs\**\*.cs" />
    <Compile Include="..\..\Assets\**\*.cs" Exclude="..\..\Assets\WintryVR\Editor\**\*.cs;..\..\Assets\WintryVR\Tests\**\*.cs" />
  </ItemGroup>
</Project>
